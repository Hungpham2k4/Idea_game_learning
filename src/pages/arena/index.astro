---
/**
 * @file src/pages/arena/index.astro
 * @description Sảnh Code Arena — khu vực chơi chung realtime.
 */
import GameLayout from '@/layouts/GameLayout.astro';
import ArenaLobby from '@/components/arena/ArenaLobby';
---

<GameLayout title="Code Arena" active="arena">
    <main class="pb-16">
        <section class="border-b border-cq-line bg-cq-panel/40">
            <div class="mx-auto max-w-6xl px-4 py-8">
                <h1 class="text-2xl font-extrabold tracking-tight text-cq-strong sm:text-3xl">
                    Code Arena
                </h1>
                <p class="mt-1.5 max-w-3xl text-sm leading-relaxed text-cq-muted">
                    Nhiều người cùng một bản đồ. Mỗi lượt bạn có vài chục giây để tự viết một chương trình ngắn,
                    hết giờ thì code của tất cả mọi người chạy <b class="text-cq-strong">cùng lúc</b> —
                    không ai thấy nước đi của ai trước khi nộp.
                </p>
            </div>
        </section>

        <div class="mx-auto max-w-6xl px-4 py-8">
            <ArenaLobby client:load />
        </div>
    </main>
</GameLayout>
