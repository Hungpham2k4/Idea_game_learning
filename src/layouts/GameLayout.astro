---
/**
 * @file src/layouts/GameLayout.astro
 * @description Khung trang cho toàn bộ khu vực chơi game (nền tối kiểu terminal).
 *
 * Khác BaseLayout ở chỗ: nền tối, header có thanh trạng thái người chơi,
 * và không có SEO nặng vì đây là khu vực cần đăng nhập.
 */
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '@/config/site';
import UserChip from '@/components/game/UserChip';
import ThemeToggle from '@/components/game/ThemeToggle';
import '@/styles/global.css';

interface Props {
    title?: string;
    description?: string;
    /** Ẩn header khi cần toàn màn hình (ví dụ trang chơi game) */
    bare?: boolean;
    /** Đánh dấu mục đang mở trên thanh điều hướng */
    active?: 'hub' | 'leaderboard' | 'profile' | 'badges' | null;
}

const { title, description, bare = false, active = null } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_CONFIG.name}` : `${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`;

const navItems = [
    { key: 'hub', label: 'Bản đồ game', href: '/hub', icon: '🗺️' },
    { key: 'leaderboard', label: 'Xếp hạng', href: '/leaderboard', icon: '🏆' },
    { key: 'profile', label: 'Hồ sơ', href: '/profile', icon: '🎓' },
];
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description ?? SITE_CONFIG.defaultDescription} />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#0b1120" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
        />

        <!-- Áp theme trước khi trang được vẽ, tránh chớp trắng/đen -->
        <script is:inline>
            (function () {
                try {
                    var saved = localStorage.getItem('cq_theme');
                    var theme = saved === 'light' || saved === 'dark'
                        ? saved
                        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                    document.documentElement.setAttribute('data-theme', theme);
                } catch (e) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            })();
        </script>

        <ClientRouter />
    </head>

    <body class="cq-page antialiased">
        {
            !bare && (
                <header class="sticky top-0 z-40 border-b border-cq-line bg-cq-bg/85 backdrop-blur">
                    <div class="mx-auto flex h-14 max-w-[1600px] items-center gap-4 px-4">
                        <a href="/hub" class="flex shrink-0 items-center gap-2">
                            <span class="grid h-8 w-8 place-items-center rounded-lg bg-cq-neon font-mono text-lg font-bold text-cq-onaccent">
                                &gt;_
                            </span>
                            <span class="hidden text-base font-extrabold tracking-tight text-cq-strong sm:block">
                                Code<span class="text-cq-neon">Quest</span>
                            </span>
                        </a>

                        <nav class="flex items-center gap-1">
                            {navItems.map((item) => (
                                <a
                                    href={item.href}
                                    class={`rounded-lg px-3 py-1.5 text-sm font-medium transition-colors ${
                                        active === item.key
                                            ? 'bg-cq-raised text-cq-strong'
                                            : 'text-cq-muted hover:bg-cq-raised/60 hover:text-cq-strong'
                                    }`}
                                >
                                    <span class="mr-1">{item.icon}</span>
                                    <span class="hidden sm:inline">{item.label}</span>
                                </a>
                            ))}
                        </nav>

                        <div class="ml-auto flex items-center gap-2">
                            <ThemeToggle client:load />
                            <UserChip client:load />
                        </div>
                    </div>
                </header>
            )
        }

        <slot />
    </body>
</html>
