# ═══════════════════════════════════════════════════════════════════════════
#  CodeQuest Web — biến môi trường dùng lúc BUILD
#  (Astro nhúng thẳng vào file tĩnh, nên đổi giá trị là phải build lại)
# ═══════════════════════════════════════════════════════════════════════════

# ── URL backend ──────────────────────────────────────────────────────────────
# Chạy máy:  http://localhost:8080/api/v1
# Deploy:    https://api.tenmien.com/api/v1   (URL Cloudflare Tunnel của bạn)
PUBLIC_API_URL=http://localhost:8080/api/v1

# ── URL của chính trang này ──────────────────────────────────────────────────
# Dùng cho canonical link, và để sinh file CNAME cho GitHub Pages
PUBLIC_SITE_URL=http://localhost:4321

# ── Đường dẫn gốc ────────────────────────────────────────────────────────────
# '/' nếu chạy ở tên miền riêng (khuyến nghị)
# '/ten-repo' nếu chạy ở username.github.io/ten-repo
PUBLIC_BASE_PATH=/
