{
  "name": "codequest-web",
  "type": "module",
  "version": "1.0.0",
  "description": "CodeQuest — Astro SSR (web chơi game) + React SPA (khu vực quản trị) cho nền tảng học lập trình qua game.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:pages": "node test/pages-check.mjs",
    "postbuild": "node scripts/prepare-pages.mjs",
    "build:pages": "astro build && node scripts/prepare-pages.mjs",
    "preview:pages": "npx --yes serve dist -l 4321"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^9.1.1",
    "@astrojs/react": "^4.0.7",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.16.11",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}